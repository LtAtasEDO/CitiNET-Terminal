<div class="citinet-manager">
  <header class="citinet-manager-head">
    <div>
      <div class="citinet-kicker">SECURE LOCAL EXCHANGE</div>
      <h1>CitiNet Terminal Manager</h1>
      <p>World terminals, global CitiNet pages, Tile bindings, and trace control.</p>
    </div>
    <div class="citinet-manager-actions">
      <button type="button" data-action="new-computer"><i class="fas fa-desktop"></i> New Computer</button>
      <button type="button" data-action="new-autofixer"><i class="fas fa-car"></i> New Autofixer</button>
      <button type="button" data-action="new-netpage"><i class="fas fa-globe"></i> New Netpage</button>
    </div>
  </header>

  <section class="citinet-manager-section">
    <div class="citinet-section-title">
      <h2>Terminal Profiles</h2>
      <span>{{terminalCount}} configured</span>
    </div>
    <div class="citinet-manager-list">
      {{#if terminals.length}}
        {{#each terminals}}
          <article class="citinet-manager-card" data-terminal-id="{{id}}">
            <div class="citinet-manager-card-main">
              <div class="citinet-manager-icon"><i class="fas {{icon}}"></i></div>
              <div>
                <h3>{{name}}</h3>
                <p>{{typeLabel}} · {{sceneLabel}} · {{bindingLabel}}</p>
                <div class="citinet-badges">
                  {{#if enabled.inbox}}<span>Inbox {{emailCount}}</span>{{/if}}
                  {{#if enabled.files}}<span>Files {{fileCount}}</span>{{/if}}
                  {{#if enabled.citinet}}<span>{{citinetModeLabel}}</span>{{/if}}
                  {{#if enabled.autofixer}}<span>Vehicles {{vehicleCount}}</span>{{/if}}
                  {{#if trace.enabled}}<span class="is-risk">Trace ON</span>{{/if}}
                </div>
              </div>
            </div>
            <div class="citinet-card-actions">
              <button type="button" data-action="preview" title="Preview"><i class="fas fa-eye"></i></button>
              <button type="button" data-action="edit" title="Edit"><i class="fas fa-pen"></i></button>
              <button type="button" data-action="bind" title="Bind selected Tile"><i class="fas fa-link"></i></button>
              <button type="button" data-action="reset-trace" title="Reset all player trace records"><i class="fas fa-crosshairs"></i></button>
              <button type="button" class="is-danger" data-action="delete" title="Delete"><i class="fas fa-trash"></i></button>
            </div>
          </article>
        {{/each}}
      {{else}}
        <div class="citinet-empty">No terminals yet. Create a Computer or Autofixer profile above.</div>
      {{/if}}
    </div>
  </section>

  <section class="citinet-manager-section">
    <div class="citinet-section-title">
      <h2>Global CitiNet Pages</h2>
      <span>Published pages appear on every CitiNet-enabled terminal.</span>
    </div>
    <div class="citinet-manager-list citinet-netpage-list">
      {{#if netpages.length}}
        {{#each netpages}}
          <article class="citinet-manager-card" data-netpage-id="{{id}}">
            <div class="citinet-manager-card-main">
              <div class="citinet-manager-icon"><i class="fas fa-globe"></i></div>
              <div>
                <h3>{{title}}</h3>
                <p>{{category}} · ID {{id}}</p>
                <div class="citinet-badges">
                  {{#if published}}<span>Published</span>{{else}}<span class="is-muted">Hidden</span>{{/if}}
                  {{#if shardExport.enabled}}<span><i class="fas fa-microchip"></i> Shard</span>{{/if}}
                  {{#if traceCost}}<span class="is-risk">+{{traceCost}} trace</span>{{/if}}
                </div>
              </div>
            </div>
            <div class="citinet-card-actions">
              <button type="button" data-action="edit-netpage" title="Edit"><i class="fas fa-pen"></i></button>
              <button type="button" data-action="netpage-up" title="Move up"><i class="fas fa-arrow-up"></i></button>
              <button type="button" data-action="netpage-down" title="Move down"><i class="fas fa-arrow-down"></i></button>
              <button type="button" class="is-danger" data-action="delete-netpage" title="Delete"><i class="fas fa-trash"></i></button>
            </div>
          </article>
        {{/each}}
      {{else}}
        <div class="citinet-empty">No CitiNet pages have been authored.</div>
      {{/if}}
    </div>
  </section>

  <footer class="citinet-manager-footer">
    <code>{{helperCommand}}</code>
    <button type="button" data-action="create-macro"><i class="fas fa-scroll"></i> Create/Update Helper Macro</button>
  </footer>
</div>
